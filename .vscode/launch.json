{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SecuChat",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-vv",
        "--dart-define-from-file=${workspaceFolder}/env.json"
      ]
    },
    {
      "name": "SecuChat (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
       "args": [
        "-vv",
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "SecuChat (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
       "args": [
        "-vv",
        "--dart-define-from-file=env.json"
      ]
    },
    {
      "name": "SecuChat (Trigger build APKs)",
      "request": "attach",
      "type": "dart",
      "preLaunchTask": "SecuChat(Build APKs)"
    },
    {
      "name": "SecuChat (Trigger APKBundle)",
      "request": "attach",
      "type": "dart",
      "preLaunchTask": "SecuChat(Build APKBundle)"
    }
  ],
  
}